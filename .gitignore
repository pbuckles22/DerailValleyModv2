[Ll]ibrary/
[Tt]emp/

# Derail Valley game files (NEVER push these to GitHub)
*.dll
!YardMasterSuite*.dll
DerailValley_Data/
Managed/

# Local game reference paths (copy from Directory.Build.targets.example when it exists)
Directory.Build.targets
Directory.Build.props.user

# Local compile counter (DLL InformationalVersion +BUILD). Never commit.
build_number.txt

# Full-repo Gemini XML dump (regenerate with Export-GeminiSnapshot.ps1)
Gemini_Snapshot.txt
Gemini_Snapshot_*.txt

# Transient Gemini drop (keep README tracked)
docs/gemini/*
!docs/gemini/README.md

# Local handoff notes (keep template _template.md and README in repo)
.cursor/handoff/handoff-*.md
.cursor/handoff/*-handoff-*.md

# Human-visible session notes (see AGENT_HANDOFF.md). Prefer this folder.
docs/handoff/HANDOFF-*.md
docs/handoff/*-HANDOFF-*.md

# Leftover pre-merge tree (canonical is docs/). Local copies only.
/doc/
