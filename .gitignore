!.vscode/extensions.json
.vs/
*.swp
*.swo
*~

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
[Ll]ogs/

# Common build / output
dist/
build/
[Bb]uild/
[Bb]uilds/
out/
coverage/
*.tsbuildinfo
.cache/
bin/
obj/
