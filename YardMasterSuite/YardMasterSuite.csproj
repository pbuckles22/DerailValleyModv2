<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>YardMasterSuite</AssemblyName>
    <RootNamespace>YardMasterSuite</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>CS8600;CS8602;CS8603</WarningsAsErrors>
    <!-- Local +BUILD is InformationalVersion; do not append git SHA. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Derail Valley — resolved via Directory.Build.targets (local, gitignored) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" />
    <Reference Include="BezierCurves" />
    <Reference Include="DV.BrakeSystem" />
    <Reference Include="DV.Inventory" />
    <Reference Include="DV.RailTrack" />
    <Reference Include="DV.PointSet" />
    <Reference Include="DV.SignPlacer" />
    <Reference Include="DV.Simulation" />
    <Reference Include="DV.ThingTypes" />
    <Reference Include="DV.Interaction" />
    <Reference Include="DV.Utils" />
    <Reference Include="Rewired_Core" />
  </ItemGroup>

  <!-- Unity -->
  <ItemGroup>
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.ImageConversionModule" />
    <Reference Include="UnityEngine.PhysicsModule" />
    <Reference Include="UnityEngine.IMGUIModule" />
    <Reference Include="UnityEngine.InputLegacyModule" />
    <Reference Include="UnityEngine.TextRenderingModule" />
  </ItemGroup>

  <!-- Mod Loader (NuGet; same as derail-valley-modding/template-umm) -->
  <ItemGroup>
    <PackageReference Include="UnityModManager" Version="0.27.2" />
  </ItemGroup>

  <!-- Null Checking -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Compile Core into this assembly (single DLL for UMM).
    Unity Mono fails to LoadFile/LoadFrom sibling YardMasterSuite.Core.dll.
    Unit tests still use the separate YardMasterSuite.Core project.
  -->
  <ItemGroup>
    <Compile Include="..\YardMasterSuite.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Local +BUILD counter (gitignored build_number.txt). Injected as
    InformationalVersion "2.1.1+104". Skip DesignTimeBuild so IntelliSense
    does not burn numbers. Do not write this into tracked info.json.
  -->
  <Target Name="IncrementBuildNumber" BeforeTargets="GetAssemblyVersion;GetAssemblyAttributes" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_YmsRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</_YmsRepoRoot>
      <_BuildNumberFile>$(_YmsRepoRoot)build_number.txt</_BuildNumberFile>
      <_InfoJsonFile>$(_YmsRepoRoot)info.json</_InfoJsonFile>
    </PropertyGroup>
    <PropertyGroup Condition="Exists('$(_BuildNumberFile)')">
      <_RawBuild>$([System.IO.File]::ReadAllText('$(_BuildNumberFile)').Trim())</_RawBuild>
    </PropertyGroup>
    <PropertyGroup>
      <_RawBuild Condition="'$(_RawBuild)' == ''">0</_RawBuild>
      <YmsBuildNumber>$([MSBuild]::Add($(_RawBuild), 1))</YmsBuildNumber>
      <_InfoJson>$([System.IO.File]::ReadAllText('$(_InfoJsonFile)'))</_InfoJson>
    </PropertyGroup>
    <PropertyGroup>
      <YmsInfoVersion>$([System.Text.RegularExpressions.Regex]::Match($(_InfoJson), '"Version"\s*:\s*"([^"]+)"').Groups[1].Value)</YmsInfoVersion>
    </PropertyGroup>
    <PropertyGroup>
      <Version>$(YmsInfoVersion)</Version>
      <InformationalVersion>$(YmsInfoVersion)+$(YmsBuildNumber)</InformationalVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildNumberFile)" Lines="$(YmsBuildNumber)" Overwrite="true" Encoding="UTF-8" />
    <Message Text="YMS InformationalVersion $(InformationalVersion)" Importance="high" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <_ModDeploy Include="$(TargetPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModDeploy)" DestinationFolder="../build/" />
    <!-- Drop stale sibling Core if a previous build left it in build/ -->
    <Delete Files="../build/YardMasterSuite.Core.dll" ContinueOnError="true" />
  </Target>
</Project>
